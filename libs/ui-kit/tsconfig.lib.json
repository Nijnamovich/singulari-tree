{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "AUTOGENERATED",
    "declaration": true,
    "declarationDir": "AUTOGENERATED",
    // `$localize` is ambient in `@angular/localize` (the package root declares the global).
    // Only the *types* are needed here: the runtime is installed once by the host app, which
    // loads `@angular/localize/init` as a polyfill. Importing it from the library would add a
    // runtime side effect to the published bundle, so a `types` entry is used instead.
    "types": ["@angular/localize"],
    // Library build only: resolve the contract type aliases to the declaration mirrors emitted
    // by `tsconfig.contracts.json` instead of the generated `*.ts` sources. ng-packagr pins
    // `rootDir` to `src/`, so importing a `.ts` file from `libs/contracts/gen/ts` fails with
    // TS6059, while a `.d.ts` is exempt. This does NOT change the alias contract declared in
    // `tsconfig.json` (used by the app/editors) nor the generated API: the emitted `.d.ts` and
    // FESM keep the original `@contracts/*` / `@singularitree/contracts/*` specifiers, because
    // rolldown treats bare specifiers as external and `import type` is erased at runtime.
    // HAND-MAINTAINED: same alias keys as `tsconfig.json`, retargeted at the declaration mirror;
    // keep both lists in sync when a contract subpath is added or renamed.
    "paths": {
      "@contracts/*": ["../../dist/libs/contracts-types/*"],
      "@singularitree/contracts/*": ["../../dist/libs/contracts-types/*"]
    }
  },
  "files": ["AUTOGENERATED"],
  "exclude": ["node_modules", "dist", "**/*.spec.ts"]
}
