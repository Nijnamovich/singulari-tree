  "private": true,
  "description": "SingulariTree shared Angular UI kit — dumb presentational components",
  "peerDependencies": {
    "@angular/core": "^22.0.0",
    "@angular/common": "^22.0.0",
    "@angular/cdk": "^22.0.0",
    "@angular/platform-browser": "^22.0.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.1",
